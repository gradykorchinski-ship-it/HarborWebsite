---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Harbor">
	<nav class="nav">
		<div class="container nav-inner">
			<a href="/" class="nav-logo">
				<img src="/harbor.png" alt="Harbor Logo" class="nav-icon" />
			</a>
			<div class="nav-links">
				<a href="#features">Features</a>
				<a href="#syntax">Syntax</a>
				<a href="/docs/">Docs</a>
				<a href="/install/">Install</a>
			</div>
			<div class="nav-actions">
				<a
					href="https://github.com/gradykorchinski-ship-it/Harbor"
					class="nav-github"
					aria-label="GitHub"
				>
					<svg
						width="20"
						height="20"
						viewBox="0 0 16 16"
						fill="currentColor"
						><path
							d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"
						></path></svg
					>
				</a>
				<a href="#get-started" class="btn-primary">Get started</a>
			</div>
		</div>
	</nav>

	<main>
		<section class="hero">
			<div class="container">
				<div class="hero-content">
					<p class="hero-version">Harbor v2.0.0</p>
					<h1>A scripting language<br />for the backend</h1>
					<p class="hero-desc">
						Harbor compiles to clean, zero-dependency Node.js. Write
						server logic in a simple syntax — no package.json, no
						node_modules, no build step.
					</p>
					<div class="hero-actions">
						<a href="#get-started" class="btn-primary"
							>Get started</a
						>
						<a
							href="https://github.com/gradykorchinski-ship-it/Harbor"
							class="btn-outline">Documentation</a
						>
					</div>
				</div>
				<div class="hero-code">
					<div class="code-block">
						<div class="code-title">app.hb</div>
						<pre><code><span class="tk">set</span> port = <span class="tn">8080</span>

<span class="tk">server</span> port &#123;
  <span class="tk">get</span> <span class="ts">"/ping"</span> &#123;
    <span class="tk">respond</span> &#123; <span class="ts">"status"</span>: <span class="ts">"ok"</span> &#125;
  &#125;
&#125;</code></pre>
					</div>
				</div>
			</div>
		</section>

		<section class="stats">
			<div class="container stats-grid">
				<div class="stat">
					<span class="stat-value">0</span>
					<span class="stat-label">Runtime dependencies</span>
				</div>
				<div class="stat">
					<span class="stat-value">&lt;2ms</span>
					<span class="stat-label">Cold start time</span>
				</div>
				<div class="stat">
					<span class="stat-value">Node.js</span>
					<span class="stat-label">Compile target</span>
				</div>
			</div>
		</section>

		<section id="features" class="features">
			<div class="container">
				<h2>Built for backend development</h2>
				<p class="section-desc">
					Harbor gives you a focused set of primitives for writing
					servers, APIs, and background tasks.
				</p>

				<div class="feature-grid">
					<div class="feature-card">
						<h3>Native networking</h3>
						<p>
							Built-in <code>fetch</code> and <code>server</code> blocks
							with async support generated at compile time. No imports
							needed.
						</p>
					</div>
					<div class="feature-card">
						<h3>Zero dependencies</h3>
						<p>
							Compiles to pure Node.js standard library code. No
							external packages in your output — ever.
						</p>
					</div>
					<div class="feature-card">
						<h3>General-purpose scripting</h3>
						<p>
							Run code before your server starts. Warm caches,
							load secrets, validate config — all in the same
							file.
						</p>
					</div>
					<div class="feature-card">
						<h3>Simple control flow</h3>
						<p>
							First-class <code>if</code>/<code>else</code>,
							variables with <code>set</code>, and deep array
							indexing.
						</p>
					</div>
					<div class="feature-card">
						<h3>Fast compilation</h3>
						<p>
							Compiles to readable Node.js in milliseconds. No
							intermediate build steps or bundler configuration.
						</p>
					</div>
					<div class="feature-card">
						<h3>Edge and serverless</h3>
						<p>
							Small output, no dependencies, fast cold starts.
							Runs anywhere Node.js does.
						</p>
					</div>
				</div>
			</div>
		</section>

		<section id="syntax" class="syntax">
			<div class="container">
				<div class="syntax-layout">
					<div class="syntax-text">
						<h2>Write less, ship more</h2>
						<p class="section-desc">
							Harbor's syntax is designed to be read at a glance.
							Define routes, make HTTP requests, and manage state
							without boilerplate.
						</p>
						<ul class="syntax-list">
							<li><code>server</code> starts an HTTP server</li>
							<li><code>fetch</code> makes outbound requests</li>
							<li><code>set</code> declares variables</li>
							<li><code>respond</code> sends JSON responses</li>
						</ul>
					</div>
					<div class="code-block code-block-lg">
						<div class="code-title">app.hb</div>
						<pre><code><span class="tk">set</span> port = <span class="tn">8080</span>
<span class="tk">set</span> api = <span class="ts">"https://api.github.com"</span>

<span class="tc">// Initialize before server starts</span>
<span class="tk">fetch</span> api + <span class="ts">"/status"</span> &#123;
  <span class="tk">set</span> system_status = res.body.status
&#125;

<span class="tk">server</span> port &#123;
  <span class="tk">get</span> <span class="ts">"/ping"</span> &#123;
    <span class="tk">respond</span> &#123; <span class="ts">"status"</span>: system_status &#125;
  &#125;
&#125;</code></pre>
					</div>
				</div>
			</div>
		</section>

		<section id="get-started" class="get-started">
			<div class="container">
				<h2>Get started</h2>
				<p class="section-desc">
					Install Harbor globally, then create and run your first
					server.
				</p>

				<div class="install-steps">
					<div class="install-step">
						<span class="step-num">1</span>
						<div class="step-content">
							<h3>Install</h3>
							<div class="terminal">
								<span class="terminal-prompt">$</span>
								<code
									>curl -sSL
									https://harbor.fluxlinux.xyz/install.sh |
									bash</code
								>
							</div>
						</div>
					</div>
					<div class="install-step">
						<span class="step-num">2</span>
						<div class="step-content">
							<h3>Write</h3>
							<div class="terminal">
								<code
									><span class="tk">server</span>
									<span class="tn">3000</span> &#123;
									<span class="tk">get</span>
									<span class="ts">"/"</span> &#123;
									<span class="tk">respond</span> &#123; <span
										class="ts">"hello"</span
									>: <span class="ts">"world"</span> &#125; &#125;
									&#125;</code
								>
							</div>
						</div>
					</div>
					<div class="install-step">
						<span class="step-num">3</span>
						<div class="step-content">
							<h3>Run</h3>
							<div class="terminal">
								<span class="terminal-prompt">$</span>
								<code>harbor app.hb</code>
							</div>
						</div>
					</div>
				</div>

				<div class="cta-row">
					<a href="/docs/" class="btn-primary">Read the docs</a>
					<a
						href="https://github.com/gradykorchinski-ship-it/Harbor"
						class="btn-outline">View on GitHub</a
					>
				</div>
			</div>
		</section>
	</main>

	<footer class="footer">
		<div class="container footer-inner">
			<div class="footer-left">
				<a href="/" class="footer-brand">
					<img src="/harbor.png" alt="" class="footer-icon" />
					Harbor
				</a>
				<p>&copy; 2026 Harbor</p>
			</div>
			<div class="footer-links">
				<div class="footer-col">
					<h4>Product</h4>
					<a href="#features">Features</a>
					<a href="#syntax">Syntax</a>
					<a href="#get-started">Get started</a>
				</div>
				<div class="footer-col">
					<h4>Resources</h4>
					<a href="https://github.com/gradykorchinski-ship-it/Harbor"
						>Documentation</a
					>
					<a href="https://github.com/gradykorchinski-ship-it/Harbor"
						>GitHub</a
					>
					<a
						href="https://github.com/gradykorchinski-ship-it/Harbor/releases"
						>Releases</a
					>
				</div>
			</div>
		</div>
	</footer>
</Layout>

<style>
	/* ── Nav ── */
	.nav {
		position: sticky;
		top: 0;
		z-index: 100;
		background: var(--bg);
		border-bottom: 1px solid var(--border);
	}

	.nav-inner {
		display: flex;
		align-items: center;
		height: 80px;
		gap: 32px;
	}

	.nav-logo {
		display: flex;
		align-items: center;
		gap: 8px;
		font-weight: 600;
		font-size: 15px;
		color: var(--text);
		white-space: nowrap;
	}

	.nav-icon {
		height: 48px;
		width: auto;
	}

	.nav-links {
		display: flex;
		gap: 24px;
	}

	.nav-links a {
		font-size: 14px;
		color: var(--text-secondary);
		transition: color 120ms;
	}

	.nav-links a:hover {
		color: var(--text);
	}

	.nav-actions {
		display: flex;
		align-items: center;
		gap: 16px;
		margin-left: auto;
	}

	.nav-github {
		color: var(--text-secondary);
		display: flex;
		transition: color 120ms;
	}

	.nav-github:hover {
		color: var(--text);
	}

	.btn-primary {
		display: inline-flex;
		align-items: center;
		padding: 6px 16px;
		background: var(--accent);
		color: var(--accent-text);
		font-size: 14px;
		font-weight: 600;
		border-radius: var(--radius);
		transition: background 120ms;
	}

	.btn-primary:hover {
		background: var(--accent-hover);
	}

	.btn-outline {
		display: inline-flex;
		align-items: center;
		padding: 6px 16px;
		background: transparent;
		color: var(--text);
		font-size: 14px;
		font-weight: 600;
		border-radius: var(--radius);
		border: 1px solid var(--border-hover);
		transition:
			background 120ms,
			border-color 120ms;
	}

	.btn-outline:hover {
		background: var(--surface);
		border-color: var(--text-tertiary);
	}

	/* ── Hero ── */
	.hero {
		padding: 80px 0 64px;
	}

	.hero .container {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 64px;
		align-items: center;
	}

	.hero-version {
		font-size: 13px;
		font-weight: 600;
		color: var(--accent);
		margin-bottom: 16px;
	}

	.hero h1 {
		margin-bottom: 20px;
	}

	.hero-desc {
		font-size: 16px;
		line-height: 1.65;
		margin-bottom: 32px;
		max-width: 480px;
	}

	.hero-actions {
		display: flex;
		gap: 12px;
	}

	.hero-actions .btn-primary,
	.hero-actions .btn-outline {
		padding: 10px 24px;
		font-size: 15px;
	}

	/* ── Code blocks ── */
	.code-block {
		background: var(--bg-secondary);
		border: 1px solid var(--border);
		border-radius: var(--radius-lg);
		overflow: hidden;
	}

	.code-title {
		padding: 10px 16px;
		font-family: var(--font-mono);
		font-size: 12px;
		color: var(--text-tertiary);
		border-bottom: 1px solid var(--border);
		background: var(--surface);
	}

	.code-block pre {
		padding: 20px;
		margin: 0;
		background: transparent;
	}

	.code-block code {
		color: var(--text-secondary);
	}

	/* Syntax tokens */
	.tk {
		color: #c586c0;
	}
	.ts {
		color: #ce9178;
	}
	.tn {
		color: #b5cea8;
	}
	.tc {
		color: #6a9955;
		font-style: italic;
	}

	/* ── Stats ── */
	.stats {
		border-top: 1px solid var(--border);
		border-bottom: 1px solid var(--border);
		padding: 40px 0;
	}

	.stats-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 32px;
	}

	.stat {
		display: flex;
		flex-direction: column;
		gap: 4px;
	}

	.stat-value {
		font-size: 24px;
		font-weight: 600;
		color: var(--text);
	}

	.stat-label {
		font-size: 14px;
		color: var(--text-tertiary);
	}

	/* ── Features ── */
	.features {
		padding: 80px 0;
	}

	.features h2 {
		margin-bottom: 8px;
	}

	.section-desc {
		color: var(--text-secondary);
		font-size: 16px;
		max-width: 560px;
		margin-bottom: 48px;
	}

	.feature-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 1px;
		background: var(--border);
		border: 1px solid var(--border);
		border-radius: var(--radius-lg);
		overflow: hidden;
	}

	.feature-card {
		background: var(--bg);
		padding: 32px;
	}

	.feature-card h3 {
		margin-bottom: 8px;
	}

	.feature-card p {
		font-size: 14px;
		line-height: 1.6;
		color: var(--text-tertiary);
	}

	.feature-card code {
		font-size: 13px;
		padding: 1px 5px;
		background: var(--surface);
		border-radius: 3px;
		color: var(--text-secondary);
	}

	/* ── Syntax section ── */
	.syntax {
		padding: 80px 0;
		background: var(--bg-secondary);
		border-top: 1px solid var(--border);
		border-bottom: 1px solid var(--border);
	}

	.syntax-layout {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 64px;
		align-items: start;
	}

	.syntax-text h2 {
		margin-bottom: 12px;
	}

	.syntax-text .section-desc {
		margin-bottom: 32px;
	}

	.syntax-list {
		list-style: none;
		display: flex;
		flex-direction: column;
		gap: 12px;
	}

	.syntax-list li {
		font-size: 14px;
		color: var(--text-secondary);
		padding-left: 16px;
		position: relative;
	}

	.syntax-list li::before {
		content: "";
		position: absolute;
		left: 0;
		top: 9px;
		width: 4px;
		height: 4px;
		border-radius: 50%;
		background: var(--accent);
	}

	.syntax-list code {
		font-size: 13px;
		padding: 1px 5px;
		background: var(--surface);
		border-radius: 3px;
		color: var(--text);
	}

	.code-block-lg pre {
		padding: 24px;
	}

	/* ── Get started ── */
	.get-started {
		padding: 80px 0;
	}

	.get-started h2 {
		margin-bottom: 8px;
	}

	.get-started .section-desc {
		margin-bottom: 48px;
	}

	.install-steps {
		display: flex;
		flex-direction: column;
		gap: 24px;
		margin-bottom: 48px;
	}

	.install-step {
		display: flex;
		gap: 20px;
		align-items: flex-start;
	}

	.step-num {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 28px;
		height: 28px;
		border-radius: 50%;
		background: var(--surface);
		border: 1px solid var(--border-hover);
		font-size: 13px;
		font-weight: 600;
		color: var(--text-secondary);
		flex-shrink: 0;
		margin-top: 2px;
	}

	.step-content {
		flex: 1;
		min-width: 0;
	}

	.step-content h3 {
		margin-bottom: 10px;
		font-size: 15px;
	}

	.terminal {
		background: var(--bg-secondary);
		border: 1px solid var(--border);
		border-radius: var(--radius-lg);
		padding: 16px 20px;
		font-family: var(--font-mono);
		font-size: 14px;
		display: flex;
		gap: 10px;
		max-width: 520px;
	}

	.terminal-prompt {
		color: var(--text-tertiary);
		user-select: none;
	}

	.terminal code {
		color: var(--text-secondary);
		white-space: nowrap;
	}

	.cta-row {
		display: flex;
		gap: 12px;
	}

	.cta-row .btn-primary,
	.cta-row .btn-outline {
		padding: 10px 24px;
		font-size: 15px;
	}

	/* ── Footer ── */
	.footer {
		border-top: 1px solid var(--border);
		padding: 48px 0;
	}

	.footer-inner {
		display: flex;
		justify-content: space-between;
		gap: 64px;
	}

	.footer-brand {
		display: flex;
		align-items: center;
		gap: 8px;
		font-weight: 600;
		font-size: 14px;
		color: var(--text);
		margin-bottom: 8px;
	}

	.footer-icon {
		height: 16px;
		width: auto;
	}

	.footer-left p {
		font-size: 13px;
		color: var(--text-tertiary);
	}

	.footer-links {
		display: flex;
		gap: 64px;
	}

	.footer-col h4 {
		font-size: 13px;
		font-weight: 600;
		color: var(--text);
		margin-bottom: 12px;
	}

	.footer-col a {
		display: block;
		font-size: 13px;
		color: var(--text-tertiary);
		padding: 3px 0;
		transition: color 120ms;
	}

	.footer-col a:hover {
		color: var(--text);
	}

	/* ── Responsive ── */
	@media (max-width: 768px) {
		.nav-links {
			display: none;
		}

		.hero {
			padding: 48px 0 40px;
		}

		.hero .container {
			grid-template-columns: 1fr;
			gap: 40px;
		}

		.stats-grid {
			grid-template-columns: 1fr;
			gap: 20px;
		}

		.feature-grid {
			grid-template-columns: 1fr;
		}

		.syntax-layout {
			grid-template-columns: 1fr;
			gap: 40px;
		}

		.footer-inner {
			flex-direction: column;
			gap: 32px;
		}

		.hero-actions,
		.cta-row {
			flex-direction: column;
			width: fit-content;
		}
	}
</style>
